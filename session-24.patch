+++ b/__tests__/auth/action-role-guard.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+function walk(dir: string, acc: string[] = []): string[] {
+  for (const name of readdirSync(dir)) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) walk(p, acc);
+    else if (name.endsWith(".action.ts")) acc.push(p);
+  }
+  return acc;
+}
+
+describe("server action role guards", () => {
+  it("every use-server action file calls requirePermission", () => {
+    const roots = ["src/modules", "src/app"];
+    const files: string[] = [];
+    for (const r of roots) {
+      try {
+        walk(r, files);
+      } catch {
+        /* missing root */
+      }
+    }
+    expect(files.length).toBeGreaterThan(5);
+    const missing: string[] = [];
+    for (const f of files) {
+      const src = readFileSync(f, "utf8");
+      if (!src.includes("requirePermission")) {
+        missing.push(f);
+      }
+    }
+    expect(missing).toEqual([]);
+  });
+});
