import { createClientAction } from "@/modules/client-company/client-company.action";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

export default async function NewClientPage({
  searchParams,
}: {
  searchParams: Promise<{ error?: string }>;
}) {
  const params = await searchParams;

  return (
    <div className="mx-auto max-w-2xl space-y-6 p-6">
      <h1 className="text-2xl font-semibold">New Client</h1>
      
      {params.error && (
        <div className="rounded border border-red-500 bg-red-50 p-3 text-sm text-red-700">
          {params.error}
        </div>
      )}

      <form action={createClientAction} className="space-y-4">
        <div className="space-y-2">
          <Label htmlFor="name">Company Name</Label>
          <Input id="name" name="name" required />
        </div>
        <div className="space-y-2">
          <Label htmlFor="code">Client Code (e.g. ARAMCO)</Label>
          <Input id="code" name="code" required />
        </div>
        <div className="space-y-2">
          <Label htmlFor="country">Country (Optional)</Label>
          <Input id="country" name="country" />
        </div>
        <Button type="submit" className="w-full">Save Client</Button>
      </form>
    </div>
  );
}