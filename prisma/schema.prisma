generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users              User[]
  branches           Branch[]
  clients            ClientCompany[]
  candidates         Candidate[]
  requisitions       JobRequisition[]
  applications       CandidateApplication[]
  screeningRecords   ScreeningRecord[]
  complianceTemplates     ComplianceTemplate[]
  complianceStepTemplates ComplianceStepTemplate[]
  complianceCases         ComplianceCase[]
  checklistInstances      ChecklistInstance[]
  medicalClearances  MedicalClearance[]
  attestationChains  AttestationChain[]
  attestationSteps   AttestationStep[]
  laborExitClearances LaborExitClearance[]
  workPermitVisas    WorkPermitVisa[]
  travelRecords      TravelRecord[]
  deploymentRecords  DeploymentRecord[]
  domainEvents       DomainEvent[]
  tasks              Task[]
}

enum UserRole {
  TENANT_ADMIN
  BRANCH_MANAGER
  RECRUITER
  MOBILIZATION_OFFICER
  COMPLIANCE_OFFICER
  FINANCE
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  branchId      String?
  email         String
  passwordHash  String?
  name          String
  role          UserRole  @default(RECRUITER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  accounts Account[]
  sessions Session[]
  assignedTasks Task[] @relation("TaskAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@index([tenantId])
}

model ClientCompany {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  country   String?
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Candidate {
  id                 String   @id @default(cuid())
  tenantId           String
  fullName           String
  email              String?
  phone              String?
  passportNumber     String? // encrypted by Session 04 middleware
  passportNumberBidx String? // blind index
  nationalId         String?
  nationalIdBidx     String?
  medicalResult      String?
  medicalResultBidx  String?
  nationality        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  applications CandidateApplication[]

  @@index([tenantId])
  @@index([tenantId, passportNumberBidx])
  @@index([tenantId, nationalIdBidx])
}

enum ReqStatus {
  OPEN
  IN_PROGRESS
  FILLED
  CANCELLED
  ON_HOLD
}

model JobRequisition {
  id                   String     @id @default(cuid())
  tenantId             String
  clientCompanyId      String
  reqCode              String // {ClientCode}-{Country}-{RoleCat}-{YYYYMM}-{Seq}
  roleCategory         String
  country              String
  vacancyTarget        Int
  location             String?
  targetOnboardingDate DateTime?
  status               ReqStatus  @default(OPEN)
  assignedRecruiterId  String?
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  applications CandidateApplication[]

  @@unique([tenantId, reqCode])
  @@index([tenantId, status])
  @@index([tenantId, clientCompanyId])
  @@index([tenantId, targetOnboardingDate])
}

enum ApplicationStatus {
  SOURCED
  SCREENED
  SHORTLISTED
  CLIENT_INTERVIEWED
  SELECTED
  MEDICAL_BOOKED
  MEDICAL_CLEARED
  DOCUMENTS_IN_ATTESTATION
  ATTESTATION_CLEARED
  VISA_APPLIED
  VISA_STAMPED
  TICKET_BOOKED
  TRAVELED
  MOBILIZED
  PROBATION
  CONFIRMED
  REJECTED
  ON_HOLD
  MEDICAL_UNFIT
  VISA_REFUSED
  ABSCONDED
}

model CandidateApplication {
  id            String            @id @default(cuid())
  tenantId      String
  candidateId   String
  requisitionId String
  status        ApplicationStatus @default(SOURCED)
  recruiterId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  candidate          Candidate           @relation(fields: [candidateId], references: [id])
  requisition        JobRequisition      @relation(fields: [requisitionId], references: [id])
  screeningRecords   ScreeningRecord[]
  complianceCase     ComplianceCase?
  medicalClearances  MedicalClearance[]
  attestationChains  AttestationChain[]
  laborExitClearances LaborExitClearance[]
  workPermitVisas    WorkPermitVisa[]
  travelRecords      TravelRecord[]
  deploymentRecords  DeploymentRecord[]

  @@unique([tenantId, candidateId, requisitionId])
  @@index([tenantId, status])
  @@index([tenantId, requisitionId])
}

enum ScreeningPath {
  BLUE
  WHITE
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  SKIPPED
  FAILED
}

model ScreeningRecord {
  id            String        @id @default(cuid())
  tenantId      String
  applicationId String
  stage         String
  path          ScreeningPath
  scorecard     Json?
  result        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([tenantId, applicationId])
}

model ComplianceTemplate {
  id                 String   @id @default(cuid())
  tenantId           String
  originCountry      String
  destinationCountry String
  roleCategory       String
  name               String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  tenant Tenant                   @relation(fields: [tenantId], references: [id])
  steps  ComplianceStepTemplate[]
  cases  ComplianceCase[]

  @@unique([tenantId, originCountry, destinationCountry, roleCategory, name])
  @@index([tenantId, originCountry, destinationCountry, roleCategory])
}

model ComplianceStepTemplate {
  id                String   @id @default(cuid())
  tenantId          String
  templateId        String
  stepOrder         Int
  name              String
  responsibleParty  String
  requiredDocuments Json
  slaDays           Int
  dependsOnStepId   String?
  connectorId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  template   ComplianceTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dependsOn  ComplianceStepTemplate? @relation("StepDependsOn", fields: [dependsOnStepId], references: [id])
  dependents ComplianceStepTemplate[] @relation("StepDependsOn")
  checklists ChecklistInstance[]

  @@unique([templateId, stepOrder])
  @@index([tenantId, templateId])
}

model ComplianceCase {
  id             String    @id @default(cuid())
  tenantId       String
  applicationId  String    @unique
  candidateId    String
  requisitionId  String
  templateId     String
  status         String    @default("PENDING")
  currentStepId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])
  template    ComplianceTemplate   @relation(fields: [templateId], references: [id])
  checklists  ChecklistInstance[]

  @@unique([tenantId, applicationId])
  @@index([tenantId, status])
  @@index([tenantId, requisitionId])
}

model ChecklistInstance {
  id             String    @id @default(cuid())
  tenantId       String
  caseId         String
  stepTemplateId String
  stepOrder      Int
  name           String
  status         String    @default("PENDING")
  completedAt    DateTime?
  completedBy    String?
  documents      Json      @default("[]")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  case         ComplianceCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stepTemplate ComplianceStepTemplate @relation(fields: [stepTemplateId], references: [id])
  medicalClearance MedicalClearance?
  attestationChain AttestationChain?
  laborExit        LaborExitClearance?
  workPermitVisa   WorkPermitVisa?
  travelRecord     TravelRecord?
  deploymentRecord DeploymentRecord?

  @@unique([caseId, stepTemplateId])
  @@index([tenantId, caseId, stepOrder])
  @@index([tenantId, status])
}

model MedicalClearance {
  id              String    @id @default(cuid())
  tenantId        String
  checklistId     String?   @unique
  centerName      String?
  centerCountry   String?
  resultDate      DateTime?
  notes           String?
  applicationId   String
  wafidGamcaId    String?
  center          String?
  appointmentDate DateTime?
  result          String?
  expiry          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, applicationId])
}

model AttestationChain {
  id            String   @id @default(cuid())
  tenantId      String
  checklistId   String?  @unique
  status        String   @default("PENDING")
  applicationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])
  steps       AttestationStep[]

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, applicationId])
}

model AttestationStep {
  id              String          @id @default(cuid())
  tenantId        String
  chainId         String
  stepOrder       Int?
  authority       String?
  referenceNo     String?
  notes           String?
  name            String
  status          ChecklistStatus @default(PENDING)
  completedAt     DateTime?
  dependsOnStepId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  chain     AttestationChain @relation(fields: [chainId], references: [id])
  dependsOn AttestationStep? @relation("AttestationStepDependency", fields: [dependsOnStepId], references: [id])
  dependents AttestationStep[] @relation("AttestationStepDependency")

  @@index([tenantId])
  @@index([tenantId, chainId])
  @@index([tenantId, status])
}

model LaborExitClearance {
  id            String          @id @default(cuid())
  tenantId      String
  checklistId   String?   @unique
  referenceNo   String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  notes         String?
  applicationId String
  clearanceType String?
  status        ChecklistStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, applicationId])
}

model WorkPermitVisa {
  id             String    @id @default(cuid())
  tenantId       String
  checklistId    String?   @unique
  visaType       String?
  expiryDate     DateTime?
  sponsorName    String?
  notes          String?
  applicationId  String
  visaNumber     String? // encrypted by Session 04 middleware
  visaNumberBidx String?
  appliedAt      DateTime?
  stampedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, applicationId])
  @@index([tenantId, visaNumberBidx])
}

model TravelRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  checklistId         String?   @unique
  airline             String?
  departureCity       String?
  arrivalCity         String?
  notes               String?
  applicationId       String
  ticketRef           String?
  flightNumber        String?
  departureAt         DateTime?
  arrivalConfirmedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, applicationId])
}

model DeploymentRecord {
  id                String    @id @default(cuid())
  tenantId          String
  checklistId       String?   @unique
  clientContact     String?
  onSiteConfirmed   Boolean   @default(false)
  notes             String?
  applicationId     String
  mobilizedAt       DateTime?
  site              String?
  onSiteConfirmedAt DateTime?
  probationEndsAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id])

  checklist   ChecklistInstance?   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([tenantId, applicationId])
}

model DomainEvent {
  id           String    @id @default(cuid())
  tenantId     String
  type         String
  payload      Json
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime? // null = pending outbox dispatch

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, dispatchedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  entity    String
  entityId  String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

enum TaskType {
  FOLLOW_UP_MEDICAL
  FOLLOW_UP_ATTESTATION
  FOLLOW_UP_VISA
  FOLLOW_UP_DOCUMENTS
  CLIENT_UPDATE
  SCHEDULE_INTERVIEW
  COMPLIANCE_INITIATE
  TRAVEL_BOOKING
  ARRIVAL_CONFIRM
  PROBATION_CHECK_IN
  EXIT_RECORD
  CUSTOM
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id           String       @id @default(cuid())
  tenantId     String
  assigneeId   String?
  type         TaskType
  refType      String
  refId        String
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  notes        String?
  generatedKey String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@unique([tenantId, generatedKey])
  @@index([tenantId, assigneeId, status, dueDate])
  @@index([tenantId, refType, refId])
  @@index([tenantId, status, dueDate])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
